rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ownsPath(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validBook(userId) {
      let book = request.resource.data;
      return book.keys().hasAll([
          'ownerUid', 'title', 'author', 'genre', 'description',
          'imageUrl', 'createdAt', 'updatedAt'
        ])
        && book.keys().hasOnly([
          'ownerUid', 'title', 'author', 'genre', 'description',
          'imageUrl', 'createdAt', 'updatedAt'
        ])
        && book.ownerUid == userId
        && book.title is string && book.title.size() > 0 && book.title.size() <= 120
        && book.author is string && book.author.size() > 0 && book.author.size() <= 100
        && book.genre is string && book.genre.size() > 0 && book.genre.size() <= 60
        && book.description is string && book.description.size() <= 500
        && book.imageUrl is string
        && book.imageUrl.matches('^https://res[.]cloudinary[.]com/.+')
        && book.createdAt is timestamp
        && book.updatedAt is timestamp;
    }

    match /users/{userId}/books/{bookId} {
      allow get, list: if ownsPath(userId);
      allow create: if ownsPath(userId)
        && validBook(userId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if ownsPath(userId)
        && resource.data.ownerUid == userId
        && validBook(userId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if ownsPath(userId) && resource.data.ownerUid == userId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
